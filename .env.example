# RAGaaS — environment variable template
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored and must
# NEVER be read or edited by an agent — only this `.env.example` file is. See
# .claude/rules/config-management.md and docs/reference/configuration.md.
#
# These are bootstrap/infra-level settings only (connection strings, secrets).
# Runtime-tunable behavior (which DB/storage/LLM/payment provider is *active*)
# lives in the `system_config` Mongo document instead — see
# config/system_config.example.json. Env vars here are the fallback default
# when `system_config` has no value for a given setting.

# --- App ---
APP_ENV=local                      # local | staging | production
APP_SECRET_KEY=                    # used to sign/verify JWTs (python-jose)
APP_LOG_LEVEL=INFO

# --- ConfigService fallback defaults (system_config precedence layers 2/3) ---
# ConfigService (app/core/config.py) resolves each system_config section as:
# Mongo system_config doc -> these env vars -> the field default baked into
# app.core.settings.Settings if the env var itself is unset. Values here mirror
# config/system_config.example.json's documented defaults and must stay in sync.
DB_ACTIVE=postgres                  # db.active fallback (postgres | mongo)
STORAGE_ACTIVE=local                # storage.active fallback (local | s3 | gcs | azure)
LLM_ACTIVE=openai                   # llm.active fallback (openai | anthropic | azure_openai | ollama)
LLM_MODEL=gpt-4o-mini               # llm.model fallback
LLM_TEMPERATURE=0.2                 # llm.temperature fallback
LLM_MAX_TOKENS=1024                 # llm.max_tokens fallback
LLM_EMBEDDING_MODEL=text-embedding-3-small  # llm.embedding_model fallback
PAYMENT_ACTIVE=stripe               # payment.active fallback (stripe | razorpay | paypal)
VECTORSTORE_ACTIVE=qdrant           # vectorstore.active fallback
SAFETY_RATE_LIMIT_RPM=60            # safety.rate_limit.requests_per_minute fallback
SAFETY_MODERATION_ACTIVE=openai     # safety.moderation.active fallback
INGESTION_MAX_UPLOAD_SIZE_BYTES=20971520          # ingestion.max_upload_size_bytes fallback (bytes, 20 MiB)
INGESTION_ALLOWED_EXTENSIONS=.txt,.pdf,.docx,.xlsx,.csv  # ingestion.allowed_extensions fallback (comma-separated)
CONFIG_CACHE_TTL_SECONDS=30         # ConfigService in-process cache TTL (seconds)

# --- PostgreSQL (SQLAlchemy async + Alembic) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=raas
POSTGRES_USER=raas
POSTGRES_PASSWORD=

# --- MongoDB (Motor) — also hosts the system_config collection ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=raas

# --- Redis (Celery broker/result backend, rate limiting, token blacklist) ---
REDIS_URL=redis://localhost:6379/0

# --- Qdrant (default vector store) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Auth (python-jose + passlib[bcrypt]) ---
JWT_ALGORITHM=HS256                 # python-jose signing algorithm, paired with APP_SECRET_KEY
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- LLM providers (ILLMProvider / IEmbeddingProvider implementations) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OLLAMA_BASE_URL=http://localhost:11434

# --- Object storage (IStorageService implementations) ---
LOCAL_STORAGE_BASE_PATH=./var/storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=
GCS_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=

# --- Payment providers (IPaymentProvider implementations) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Content moderation (IModerationProvider implementations) ---
OPENAI_MODERATION_API_KEY=

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000  # canonical origin for absolute URLs in sitemap.xml/robots.txt (STORY-007)
