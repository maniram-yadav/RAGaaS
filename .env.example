# RAGaaS — environment variable template
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored and must
# NEVER be read or edited by an agent — only this `.env.example` file is. See
# .claude/rules/config-management.md and docs/reference/configuration.md.
#
# These are bootstrap/infra-level settings only (connection strings, secrets).
# Runtime-tunable behavior (which DB/storage/LLM/payment provider is *active*)
# lives in the `system_config` Mongo document instead — see
# config/system_config.example.json. Env vars here are the fallback default
# when `system_config` has no value for a given setting.

# --- App ---
APP_ENV=local                      # local | staging | production
APP_SECRET_KEY=                    # used to sign/verify JWTs (python-jose)
APP_LOG_LEVEL=INFO

# --- PostgreSQL (SQLAlchemy async + Alembic) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=raas
POSTGRES_USER=raas
POSTGRES_PASSWORD=

# --- MongoDB (Motor) — also hosts the system_config collection ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=raas

# --- Redis (Celery broker/result backend, rate limiting, token blacklist) ---
REDIS_URL=redis://localhost:6379/0

# --- Qdrant (default vector store) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Auth (python-jose + passlib[bcrypt]) ---
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- LLM providers (ILLMProvider / IEmbeddingProvider implementations) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OLLAMA_BASE_URL=http://localhost:11434

# --- Object storage (IStorageService implementations) ---
LOCAL_STORAGE_BASE_PATH=./var/storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=
GCS_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=

# --- Payment providers (IPaymentProvider implementations) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Content moderation (IModerationProvider implementations) ---
OPENAI_MODERATION_API_KEY=

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
