{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Read(.env.local)",
      "Read(**/.env.local)",
      "Read(.env.production)",
      "Read(**/.env.production)",
      "Read(.env.development)",
      "Read(**/.env.development)",
      "Read(.env.test)",
      "Read(**/.env.test)",
      "Read(.env.staging)",
      "Read(**/.env.staging)",
      "Edit(.env)",
      "Edit(**/.env)",
      "Edit(.env.local)",
      "Edit(**/.env.local)",
      "Edit(.env.production)",
      "Edit(**/.env.production)",
      "Edit(.env.development)",
      "Edit(**/.env.development)",
      "Edit(.env.test)",
      "Edit(**/.env.test)",
      "Edit(.env.staging)",
      "Edit(**/.env.staging)",
      "Write(.env)",
      "Write(**/.env)",
      "Write(.env.local)",
      "Write(**/.env.local)",
      "Write(.env.production)",
      "Write(**/.env.production)",
      "Write(.env.development)",
      "Write(**/.env.development)",
      "Write(.env.test)",
      "Write(**/.env.test)",
      "Write(.env.staging)",
      "Write(**/.env.staging)"
    ],
    "allow": [
      "Read(.env.example)",
      "Read(**/.env.example)",
      "Edit(.env.example)",
      "Edit(**/.env.example)",
      "Write(.env.example)",
      "Write(**/.env.example)",
      "Bash(pytest*)",
      "Bash(python -m pytest*)",
      "Bash(npm test*)",
      "Bash(npm run test*)",
      "Bash(npm run dev*)",
      "Bash(npm install)",
      "Bash(ruff*)",
      "Bash(mypy*)",
      "Bash(eslint*)",
      "Bash(npx eslint*)",
      "Bash(tsc --noEmit*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(docker compose up*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(alembic*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(tail)",
      "Bash(git log*)",
      "Bash(git status --short && git log --oneline -5)"
    ]
  }
}
